{
  "rules": {
    ".read": false,
    ".write": false,

    "schedule": {
      ".read": "auth != null",
      ".write": "auth.token.email === 'tejasvsingh001@gmail.com' && auth.token.email_verified === true"
    },

    "q5_attendance": {
      ".read": "auth != null",
      ".write": false
    },

    "q6_attendance": {
      ".read": "auth != null",
      "$roll": {
        ".validate": "$roll.length <= 40",
        "$session": {
          ".write": "auth != null",
          ".validate": "newData.val() === 'P' || newData.val() === 'A'"
        }
      }
    },

    "roll_preferences": {
      ".read": "auth != null",
      "$roll": {
        ".write": "auth != null",
        ".validate": "$roll.length <= 40 && newData.child('updatedAt').isNumber()"
      }
    },

    "attendance_trackers": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null",
        ".validate": "$key.length <= 60 && newData.hasChildren()"
      }
    },

    "groups": {
      ".read": "auth != null",
      "$code": {
        ".validate": "$code.length <= 40",
        "members": {
          "$name": {
            ".write": "auth != null",
            ".validate": "$name.length <= 40"
          }
        }
      }
    },

    "push_tokens": {
      ".read": false,
      "$roll": {
        ".validate": "$roll.length <= 40",
        "$device": {
          ".write": "auth != null",
          ".validate": "$device.length <= 40 && newData.hasChildren(['token', 'at']) && newData.child('token').isString() && newData.child('token').val().length <= 512 && newData.child('at').isNumber()",
          "prefs": { "$k": { ".validate": "newData.isBoolean()" } }
        }
      }
    },

    "admin_ping": {
      ".read": false,
      "$uid": {
        ".write": "auth != null && $uid === auth.uid && (!newData.exists() || newData.child('pin').val() === '__ADMIN_PIN__')",
        ".validate": "newData.hasChild('pin')"
      }
    },

    "announcements": {
      ".read": false,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.child('pin').val() === '__ADMIN_PIN__'",
        ".validate": "newData.hasChildren(['title', 'body', 'at', 'pin']) && newData.child('title').isString() && newData.child('title').val().length <= 80 && newData.child('body').isString() && newData.child('body').val().length <= 240 && newData.child('at').isNumber()"
      }
    },

    "announcements_log": {
      ".read": "auth != null",
      ".write": false
    },

    "push_stats": {
      ".read": "auth != null",
      ".write": false
    },

    "push_reminders": {
      ".read": false,
      "$roll": {
        ".write": "auth != null",
        ".validate": "$roll.length <= 40 && newData.hasChild('at') && newData.child('at').isNumber()"
      }
    },

    "schedule_changes": {
      ".read": "auth != null",
      "$ymd": {
        ".validate": "$ymd.matches(/^\\d{4}-\\d{2}-\\d{2}$/)",
        "$change": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['code', 'ymd', 'slot', 'status', 'byRoll', 'at'])",
          "code": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "ymd": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "slot": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "status": { ".validate": "newData.val() === 'cancelled' || newData.val() === 'moved' || newData.val() === 'retimed' || newData.val() === 'note'" },
          "byRoll": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "byName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "at": { ".validate": "newData.isNumber()" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "toYmd": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "toSlot": { ".validate": "newData.isString() && newData.val().length <= 12" },
          "start": { ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)" },
          "end": { ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)" },
          "double": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        }
      }
    },

    "schedule_changes_log": {
      ".read": "auth.token.email === 'tejasvsingh001@gmail.com' && auth.token.email_verified === true",
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['action', 'at'])"
      }
    }
  }
}
